# Git configuration for private repositories
# Use environment variables for username and token authentication
@refactory:registry=https://gitea.sev-2.com/api/packages/npm/
//gitea.sev-2.com/api/packages/npm/:_authToken=${GITEA_TOKEN}
//gitea.sev-2.com/api/packages/npm/:username=${GITEA_USERNAME}

# Git authentication using environment variables
# This will be used by npm/yarn when installing git dependencies